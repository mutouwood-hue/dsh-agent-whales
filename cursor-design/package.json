{
  "name": "whales-cursor-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "start": "node server.mjs",
    "test:ui": "node test/ui-check.mjs",
    "build:canvas": "node editor-extension/build.mjs",
    "pack:canvas": "npm run build:canvas && cd editor-extension && vsce package --no-dependencies --allow-missing-repository -o ../dist/whales-design-canvas.vsix",
    "test:canvas": "node test/canvas-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "esbuild": "0.28.2",
    "playwright-core": "^1.65.1"
  },
  "engines": {
    "node": ">=22"
  }
}
