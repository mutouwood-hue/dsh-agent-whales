{
  "name": "dsh-agent-whales",
  "version": "0.25.0",
  "description": "每多一个正在干活的智能体（Lead、teammate 或子 agent），DSH Web 页面顶端就多一只游动的鲸鱼娘。",
  "license": "MIT",
  "type": "module",
  "author": "mutouwood-hue",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.flow.js",
    "lib/client.proto.js",
    "lib/client.puck.js",
    "lib/client.view.js",
    "lib/prototype-vocab.js",
    "lib/auto-dispatch.js",
    "lib/requirements.js",
    "lib/e2e.js",
    "lib/view-host.js",
    "lib/view/*.js",
    "lib/view/LICENSE-deep-view",
    "cordis.patch.yml",
    "presets/dsh-agent-whales-worker/preset.yml",
    "presets/dsh-agent-whales-worker/agent.cordis.yml",
    "skills/*/SKILL.md",
    "locale/*.json",
    "icon.svg",
    "assets/manifest.json",
    "assets/*.webp",
    "assets/office/manifest.json",
    "assets/office/*.webp",
    "README.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutouwood-hue/dsh-agent-whales.git"
  },
  "homepage": "https://github.com/mutouwood-hue/dsh-agent-whales#readme",
  "bugs": {
    "url": "https://github.com/mutouwood-hue/dsh-agent-whales/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "whale",
    "ui"
  ],
  "scripts": {
    "test": "node --test test/",
    "build:manifest": "node tools/build-manifest.mjs",
    "pack:dist": "npm pack --pack-destination dist",
    "prepack": "node tools/build-manifest.mjs && node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('assets/manifest.json','utf8'));if(!m.keys||Object.keys(m.keys).length===0){console.error('prepack: assets/manifest.json 为空，素材没打进去');process.exit(1)}const c=fs.readFileSync('lib/client.js','utf8');if(/data:image\\/(?:webp|png|jpeg);base64,/i.test(c)){console.error('prepack: lib/client.js 仍在内联 base64 素材（D1 起素材走宿主路由 /agent-whales/api/art/*，client.js 只能含代码与矢量兜底）');process.exit(1)}\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
